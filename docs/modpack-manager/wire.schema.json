{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Awake integration 1.0 wire envelopes",
  "$defs": {
    "protocol": {
      "type": "object",
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "const": 0
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "method": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "protocol",
        "requestId",
        "method",
        "params"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "protocol": {
          "$ref": "#/$defs/protocol"
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": "object"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "protocol",
        "requestId"
      ],
      "oneOf": [
        {
          "required": [
            "result"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "result"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ]
}
