    <file alias="th.qm">@CMAKE_CURRENT_BINARY_DIR@/th.qm</file>
    <file alias="zh_CN.qm">@CMAKE_CURRENT_BINARY_DIR@/zh_CN.qm</file>
    <file alias="zh_TW.qm">@CMAKE_CURRENT_BINARY_DIR@/zh_TW.qm</file>
  </qresource>
</RCC>
